NODE_ENV=development
PORT=4000

API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
REDIS_URL=redis://localhost:6379

DATABASE_URL=postgresql://postgres:123456789@localhost:5432/redji-DB
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret

RESEND_API_KEY=
RESEND_FROM_EMAIL="Readji <noreply@readji.com>"
EMAIL_VERIFICATION_TTL_HOURS=24
TURNSTILE_SECRET_KEY=

# ThaiBulkSMS SMS OTP application credentials.
THAIBULKSMS_OTP_KEY=
THAIBULKSMS_OTP_SECRET=

# Google OAuth Web application credentials. Add
# http://localhost:4000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Store new manga chapter pages in apps/api/assets instead of R2.
# LOCAL_UPLOAD is also supported. API_ORIGIN must be reachable by the browser.
local_upload=false

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=redji
R2_PUBLIC_URL=
R2_MANGA_BUCKET_NAME=redji-manga-private


TMWEASY_API_URL=https://www.tmweasyapi.com/api_pph.php
TMWEASY_USERNAME=
TMWEASY_PASSWORD=
TMWEASY_CON_ID=
TMWEASY_API_KEY=
TMWEASY_PROMPTPAY_ID=
TMWEASY_PROMPTPAY_TYPE=01
