# Root .env — read by docker-compose.yml only (local Postgres + Redis containers)
# Copy to .env: cp .env.example .env
# Each app (apps/api, apps/web, apps/admin) has its own separate .env(.local) —
# see apps/api/.env.example, apps/web/.env.example, apps/admin/.env.example

POSTGRES_PASSWORD=change_me_locally
