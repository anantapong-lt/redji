# apps/admin/.env.example — copy to apps/admin/.env.local and fill in real values
# cp apps/admin/.env.example apps/admin/.env.local

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Public R2 host for uploaded covers/images/audio — must match apps/api's
# R2_PUBLIC_URL (same bucket, public read URL).
NEXT_PUBLIC_R2_PUBLIC_URL=
