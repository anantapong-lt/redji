# Database
POSTGRES_PASSWORD=postgres

# API Environment Variables
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# TMW Easy Payment
TMWEASY_API_URL=https://www.tmweasyapi.com/api_pph.php
TMWEASY_USERNAME=your_username
TMWEASY_PASSWORD=your_password
TMWEASY_CON_ID=your_con_id
TMWEASY_API_KEY=your_api_key
TMWEASY_PROMPTPAY_ID=your_promptpay_id
TMWEASY_PROMPTPAY_TYPE=01

# Email (Resend)
RESEND_FROM_EMAIL="Your App <onboarding@resend.dev>"
EMAIL_VERIFICATION_TTL_HOURS=24
RESEND_API_KEY=your_resend_api_key

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Web Origin
WEB_ORIGIN=http://localhost:3000

# Optional: Override API URL for web/admin
# NEXT_PUBLIC_API_URL=http://localhost:4000
