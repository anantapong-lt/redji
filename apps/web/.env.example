# apps/web/.env.example — copy to apps/web/.env.local and fill in real values
# cp apps/web/.env.example apps/web/.env.local
#
# apps/web currently has NO .env file at all — it silently runs on the
# localhost fallbacks baked into site.config.ts. Create the real file before
# deploying anywhere outside local dev.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Public R2 host for uploaded covers/images/audio — must match apps/api's
# R2_PUBLIC_URL (same bucket, public read URL).
NEXT_PUBLIC_R2_PUBLIC_URL=
