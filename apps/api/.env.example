# apps/api/.env.example — copy to apps/api/.env and fill in real values
# cp apps/api/.env.example apps/api/.env

# ---- Database ----
DATABASE_URL=postgresql://postgres:change_me_locally@localhost:5432/novelnova_db
POSTGRES_PASSWORD=change_me_locally

# ---- Redis (rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Server ----
NODE_ENV=development
PORT=3001

# CORS allowlist — must be the real deploy domains in production, or CORS
# silently blocks requests from those domains (no obvious error).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ---- Auth secrets — MUST be rotated before production if ever shared/logged ----
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Cloudflare R2 (file storage) — use a separate bucket for production ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- Payment webhook signature verification ----
WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be a domain verified with Resend before production — noreply@localhost.dev
# will not actually deliver mail.
RESEND_FROM=noreply@localhost.dev

# ---- Business config (optional — code falls back to sensible defaults) ----
# Writer's share of a sale, e.g. 0.7 = 70%
WITHDRAWAL_RATE=0.7
# Feature gate for Pro-tier TTS rendering
TTS_PRO_RENDER_ENABLED=false

# ---- Rate-limit tuning (optional — all have built-in defaults) ----
API_REQUESTS_PER_IP_PER_MINUTE=
UPLOAD_REQUESTS_PER_ACCOUNT_PER_HOUR=
UPLOAD_REQUESTS_PER_IP_PER_HOUR=
MANGA_IMAGES_PER_ACCOUNT_PER_DAY=
MANGA_IMAGES_PER_IP_PER_DAY=
